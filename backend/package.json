{
  "name": "staycation-watcher-backend",
  "version": "1.0.0",
  "description": "UK Staycation Price & Deal Watcher - Backend API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "worker": "tsx watch src/jobs/worker.ts",
    "migrate": "typeorm migration:run -d src/config/database.ts",
    "migrate:prod": "typeorm migration:run -d dist/config/database.js",
    "migrate:revert": "typeorm migration:revert -d src/config/database.ts",
    "migrate:generate": "typeorm migration:generate -d src/config/database.ts",
    "seed": "tsx src/seeds/index.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:integration": "jest tests/integration --runInBand",
    "test:authz": "jest tests/integration/authorization.test.ts",
    "db:test:up": "docker-compose up -d postgres redis",
    "db:check": "tsx src/scripts/db-check.ts",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "dependencies": {
    "@aws-sdk/client-ses": "^3.515.0",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/jwt": "^10.0.0",
    "@fastify/rate-limit": "^10.3.0",
    "argon2": "^0.44.0",
    "bullmq": "^5.1.9",
    "cheerio": "^1.0.0-rc.12",
    "dotenv": "^16.4.1",
    "fastify": "^5.8.4",
    "ioredis": "^5.3.2",
    "nodemailer": "^8.0.3",
    "pg": "^8.11.3",
    "playwright": "^1.41.2",
    "reflect-metadata": "^0.2.1",
    "typeorm": "^0.3.20",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.11.16",
    "@types/nodemailer": "^6.4.14",
    "@typescript-eslint/eslint-plugin": "^8.57.2",
    "@typescript-eslint/parser": "^8.57.2",
    "eslint": "^10.1.0",
    "jest": "^29.7.0",
    "prettier": "^3.2.5",
    "ts-jest": "^29.1.2",
    "tsx": "^4.7.0",
    "typescript": "^5.6.2",
    "@types/pg": "^8.11.2",
    "typescript-eslint": "^8.57.2",
    "vitest": "^4.1.1"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
